    <ResourceInclude Source="avares://UpSTEPer/Themes/Icons.axaml" />
    <ResourceInclude Source="avares://UpSTEPer/Themes/Controls.axaml" />
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
