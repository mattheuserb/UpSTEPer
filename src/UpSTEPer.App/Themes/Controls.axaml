<!-- Control themes of the app's own controls. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:UpSTEPer.App.Controls">
  <ControlTheme x:Key="{x:Type controls:Icon}" TargetType="controls:Icon">
    <Setter Property="Width" Value="{StaticResource IconSize}" />
    <Setter Property="Height" Value="{StaticResource IconSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- The Viewbox scales the 24x24 grid and the stroke together, as Lucide intends. -->
        <Viewbox Stretch="Uniform">
          <Canvas Width="24" Height="24">
            <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" />
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
