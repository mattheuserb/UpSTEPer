<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>UpSTEPer desktop application (Avalonia).</Description>
    <AssemblyName>UpSTEPer</AssemblyName>
    <RootNamespace>UpSTEPer.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- English texts are in the main assembly (Localization/Strings.resx); others in satellites. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpSTEPer.Core\UpSTEPer.Core.csproj" />
    <ProjectReference Include="..\UpSTEPer.Occt\UpSTEPer.Occt.csproj" />
    <ProjectReference Include="..\UpSTEPer.Rendering\UpSTEPer.Rendering.csproj" />
    <ProjectReference Include="..\UpSTEPer.Export.Dxf\UpSTEPer.Export.Dxf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Themes\Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shown by Help > About; binary distributions must include them (see THIRD-PARTY-NOTICES.md). -->
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- RAL Classic colours, generated from Wikidata by scripts/update-ral.py (see RalCatalogue). -->
    <EmbeddedResource Include="Colours/ral-classic.json" LogicalName="UpSTEPer.App.Colours.ral-classic.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Strongly typed access (Strings.Key) generated at build time; Strings.de.resx is the German satellite.
         The class is in the root namespace: dotnet format does not see generated files and would
         otherwise remove the using of a file that needs only Strings. -->
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>UpSTEPer.App</StronglyTypedNamespace>
      <StronglyTypedManifestPrefix>UpSTEPer.App.Localization</StronglyTypedManifestPrefix>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UpSTEPer.App.Tests" />
  </ItemGroup>

</Project>
