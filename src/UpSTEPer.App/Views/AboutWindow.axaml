<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:UpSTEPer.App.Localization"
        xmlns:vm="using:UpSTEPer.App.ViewModels"
        xmlns:controls="using:UpSTEPer.App.Controls"
        x:Class="UpSTEPer.App.Views.AboutWindow"
        x:ClassModifier="internal"
        x:DataType="vm:AboutInfo"
        Title="{loc:Tr About_Title}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
  <Window.Styles>
    <Style Selector="Grid.info > TextBlock">
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.info > TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,3,16,3" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="20,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button Content="{loc:Tr About_Copy}" Click="OnCopyClick" ToolTip.Tip="{loc:Tr About_TipCopy}" />
      <Button Content="{loc:Tr About_OpenLogs}" Click="OnOpenLogsClick" />
      <Button Content="{loc:Tr About_Notices}" Click="OnOpenNoticesClick" />
      <Button Content="{loc:Tr Common_Close}" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    </StackPanel>
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <controls:Icon Data="{StaticResource Icon.Box}" Width="36" Height="36" Foreground="{StaticResource AccentBrush}" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="UpSTEPer" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" Text="{loc:Tr About_Tagline}" />
        </StackPanel>
      </StackPanel>
      <Grid Classes="info" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Classes="label" Text="{loc:Tr About_Version}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Classes="label" Text="{loc:Tr About_Geometry}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeometryVersion}" />
        <TextBlock Grid.Row="2" Classes="label" Text="{loc:Tr About_Runtime}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Runtime}" />
        <TextBlock Grid.Row="3" Classes="label" Text="{loc:Tr About_System}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OperatingSystem}" />
        <TextBlock Grid.Row="4" Classes="label" Text="{loc:Tr About_Logs}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LogDirectory}" />
        <TextBlock Grid.Row="5" Classes="label" Text="{loc:Tr About_Licence}" />
        <TextBlock Grid.Row="5" Grid.Column="1"
                   Text="{loc:Tr About_LicenceText}" />
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
