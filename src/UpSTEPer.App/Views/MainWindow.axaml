<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UpSTEPer.App.ViewModels"
        xmlns:core="using:UpSTEPer.Core"
        xmlns:drawing="using:UpSTEPer.Core.Drawing"
        xmlns:controls="using:UpSTEPer.App.Controls"
        x:Class="UpSTEPer.App.Views.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="NumPad1" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Front}" />
    <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Back}" />
    <KeyBinding Gesture="NumPad3" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Right}" />
    <KeyBinding Gesture="Ctrl+NumPad3" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Left}" />
    <KeyBinding Gesture="NumPad7" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Top}" />
    <KeyBinding Gesture="Ctrl+NumPad7" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Bottom}" />
    <KeyBinding Gesture="NumPad0" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Iso}" />
    <KeyBinding Gesture="NumPad5" Command="{Binding ToggleProjectionCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#D0D4D9">
      <WrapPanel Orientation="Horizontal">
        <Button Content="Open STEP..." Click="OnOpenClick" IsEnabled="{Binding !IsBusy}" Margin="0,0,6,0" />
        <Button Content="Save as..." Click="OnSaveAsClick" HotKey="Ctrl+S" IsEnabled="{Binding HasDocument}" Margin="0,0,6,0" />
        <Button Content="Repair..." Click="OnRepairClick" IsEnabled="{Binding HasDocument}" Margin="0,0,6,0"
                ToolTip.Tip="Check the model for defects and repair it (sew gaps, exact surfaces, merge split faces)" />
        <Button Content="Export DXF..." Click="OnExportDxfClick" IsEnabled="{Binding HasDocument}" Margin="0,0,16,0"
                ToolTip.Tip="Front, top, left and isometric view with hidden lines (first-angle projection)" />

        <ListBox ItemsSource="{Binding Palette}" SelectedItem="{Binding SelectedPaletteEntry}"
                 Background="Transparent" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteEntry">
              <Border Width="22" Height="22" CornerRadius="3" Background="{Binding Hex}"
                      BorderBrush="#80000000" BorderThickness="1" ToolTip.Tip="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="CustomColorButton" Content="Custom..." Margin="0,0,12,0" VerticalAlignment="Center"
                ToolTip.Tip="Pick any colour; it is added to the palette and becomes the active colour">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="8">
                <ColorView x:Name="CustomColorView" Color="#3366CC"
                           IsAlphaEnabled="False" IsAlphaVisible="False" IsAccentColorsVisible="False" />
                <Button Content="Use colour" HorizontalAlignment="Right" Click="OnUseCustomColorClick" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Content="Colour face" Command="{Binding ColorFaceCommand}" Margin="0,0,6,0" />
        <Button Content="Colour body" Command="{Binding ColorBodyCommand}" Margin="0,0,6,0"
                ToolTip.Tip="Colours the bodies selected in the model tree, or the body of the selected face" />
        <Button Content="Remove face colour" Command="{Binding ClearFaceColorCommand}" Margin="0,0,16,0" />
        <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="Ctrl+Z" Margin="0,0,6,0" />
        <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="Ctrl+Y" Margin="0,0,16,0" />
        <CheckBox Content="Edges" IsChecked="{Binding ShowEdges}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Content="Front" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Front}"
                ToolTip.Tip="Num 1" Margin="0,0,4,0" />
        <Button Content="Back" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Back}"
                ToolTip.Tip="Ctrl+Num 1" Margin="0,0,4,0" />
        <Button Content="Left" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Left}"
                ToolTip.Tip="Ctrl+Num 3" Margin="0,0,4,0" />
        <Button Content="Right" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Right}"
                ToolTip.Tip="Num 3" Margin="0,0,4,0" />
        <Button Content="Top" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Top}"
                ToolTip.Tip="Num 7" Margin="0,0,4,0" />
        <Button Content="Bottom" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Bottom}"
                ToolTip.Tip="Ctrl+Num 7" Margin="0,0,4,0" />
        <Button Content="Iso" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Iso}"
                ToolTip.Tip="Num 0" Margin="0,0,4,0" />
        <CheckBox Content="Orthographic" IsChecked="{Binding IsOrthographic}" VerticalAlignment="Center" Margin="12,0,0,0"
                  ToolTip.Tip="Parallel projection without perspective (Num 5)" />
        <ComboBox ItemsSource="{Binding DisplayQualities}" SelectedItem="{Binding DisplayQuality}" IsEnabled="{Binding !IsBusy}"
                  VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="100"
                  ToolTip.Tip="Display quality: how finely curved faces are triangulated (the model itself is not changed)" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#D0D4D9">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" FontSize="12" Text="{Binding SelectionInfo}" />
        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="#5F6368" Margin="0,0,16,0" Text="{Binding HoverInfo}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" IsVisible="{Binding IsCancellable}">
          <TextBlock FontSize="12" Text="{Binding ProgressText}" VerticalAlignment="Center" />
          <ProgressBar Width="160" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" VerticalAlignment="Center" />
          <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="8,0" FontSize="12" ToolTip.Tip="Esc" />
        </StackPanel>
        <TextBlock FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,2">
      <TextBlock Foreground="#5F6368" FontSize="11"
                 Text="Click: select face   Left drag: rotate   Right/middle drag: pan   Wheel: zoom   Double-click: fit   Num 1/3/7/0: front/right/top/iso (Ctrl: opposite side)   Num 5: orthographic" />
    </Border>

    <Grid ColumnDefinitions="260,4,*">
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Model" FontWeight="SemiBold" Margin="10,8,8,4" />
        <TreeView ItemsSource="{Binding ModelTree}" SelectedItem="{Binding SelectedNode}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="core:ModelNode" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Kind}" Foreground="#80868B" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
      <GridSplitter Grid.Column="1" Background="#D0D4D9" ResizeDirection="Columns" />
      <controls:ModelView Grid.Column="2" x:Name="ModelViewControl"
                          Scene="{Binding Scene}" SelectedFace="{Binding SelectedFace}"
                          HighlightedFaces="{Binding HighlightedFaces}" HoveredFace="{Binding HoveredFace}" ShowEdges="{Binding ShowEdges}"
                          IsOrthographic="{Binding IsOrthographic}" />
    </Grid>
  </DockPanel>
</Window>
