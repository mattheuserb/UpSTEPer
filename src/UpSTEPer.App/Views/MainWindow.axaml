<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:UpSTEPer.App.Localization"
        xmlns:vm="using:UpSTEPer.App.ViewModels"
        xmlns:core="using:UpSTEPer.Core"
        xmlns:drawing="using:UpSTEPer.Core.Drawing"
        xmlns:controls="using:UpSTEPer.App.Controls"
        xmlns:conv="using:UpSTEPer.App.Converters"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="UpSTEPer.App.Views.MainWindow"
        x:ClassModifier="internal"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="400"
        Background="{StaticResource WindowBrush}">
  <!-- Every shortcut is bound here once; menu entries only display their gestures (InputGesture),
       toolbar buttons and menu entries share the same commands. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding #Root.OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding #Root.SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding #Root.ShowShortcutsCommand}" />
    <KeyBinding Gesture="NumPad1" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Front}" />
    <KeyBinding Gesture="Ctrl+NumPad1" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Back}" />
    <KeyBinding Gesture="NumPad3" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Right}" />
    <KeyBinding Gesture="Ctrl+NumPad3" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Left}" />
    <KeyBinding Gesture="NumPad7" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Top}" />
    <KeyBinding Gesture="Ctrl+NumPad7" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Bottom}" />
    <KeyBinding Gesture="NumPad0" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Iso}" />
    <KeyBinding Gesture="NumPad5" Command="{Binding ToggleProjectionCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- 1 Menu -->
    <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBrush}">
      <MenuItem Header="{loc:Tr Menu_File}">
        <MenuItem Header="{loc:Tr Menu_Open}" Command="{Binding #Root.OpenCommand}" InputGesture="Ctrl+O" IsEnabled="{Binding !IsBusy}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.FolderOpen}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_RecentFiles}" Classes="recentFiles" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
          <MenuItem.Styles>
            <!-- The generated entries (descendants), not this submenu itself. -->
            <Style Selector="MenuItem.recentFiles MenuItem" x:DataType="vm:RecentFileEntry">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="Command" Value="{Binding OpenCommand}" />
              <Setter Property="CommandParameter" Value="{Binding FullPath}" />
              <Setter Property="ToolTip.Tip" Value="{Binding FullPath}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_ClearRecentFiles}" Command="{Binding ClearRecentFilesCommand}" IsEnabled="{Binding HasRecentFiles}" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu_SaveAs}" Command="{Binding #Root.SaveAsCommand}" InputGesture="Ctrl+S" IsEnabled="{Binding HasDocument}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Save}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Menu_Repair}" Command="{Binding #Root.RepairCommand}" IsEnabled="{Binding HasDocument}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Wrench}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_ExportDxf}" Command="{Binding #Root.ExportDxfCommand}" IsEnabled="{Binding HasDocument}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.FileOutput}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Menu_Exit}" Command="{Binding #Root.ExitCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Tr Menu_Edit}">
        <MenuItem Header="{loc:Tr Menu_Undo}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Undo2}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_Redo}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Redo2}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Command_RemoveFaceColour}" Command="{Binding ClearFaceColorCommand}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Eraser}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{loc:Tr Menu_View}">
        <MenuItem Header="{loc:Tr Menu_Fit}" Command="{Binding #ModelViewControl.FitCommand}" InputGesture="">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Scan}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr View_Front}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Front}" InputGesture="NumPad1" />
        <MenuItem Header="{loc:Tr View_Back}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Back}" InputGesture="Ctrl+NumPad1" />
        <MenuItem Header="{loc:Tr View_Left}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Left}" InputGesture="Ctrl+NumPad3" />
        <MenuItem Header="{loc:Tr View_Right}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Right}" InputGesture="NumPad3" />
        <MenuItem Header="{loc:Tr View_Top}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Top}" InputGesture="NumPad7" />
        <MenuItem Header="{loc:Tr View_Bottom}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Bottom}" InputGesture="Ctrl+NumPad7" />
        <MenuItem Header="{loc:Tr View_Isometric}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Iso}" InputGesture="NumPad0" />
        <Separator />
        <MenuItem Header="{loc:Tr Menu_Edges}" ToggleType="CheckBox" IsChecked="{Binding ShowEdges}" />
        <MenuItem Header="{loc:Tr Menu_Orthographic}" ToggleType="CheckBox" IsChecked="{Binding IsOrthographic}" InputGesture="NumPad5" />
        <MenuItem Header="{loc:Tr Menu_DisplayQuality}">
          <MenuItem Header="{loc:Tr DisplayQuality_Coarse}" ToggleType="Radio" Command="{Binding SetDisplayQualityCommand}" CommandParameter="{x:Static core:DisplayQuality.Coarse}"
                    IsChecked="{Binding DisplayQuality, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static core:DisplayQuality.Coarse}}" />
          <MenuItem Header="{loc:Tr DisplayQuality_Normal}" ToggleType="Radio" Command="{Binding SetDisplayQualityCommand}" CommandParameter="{x:Static core:DisplayQuality.Normal}"
                    IsChecked="{Binding DisplayQuality, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static core:DisplayQuality.Normal}}" />
          <MenuItem Header="{loc:Tr DisplayQuality_Fine}" ToggleType="Radio" Command="{Binding SetDisplayQualityCommand}" CommandParameter="{x:Static core:DisplayQuality.Fine}"
                    IsChecked="{Binding DisplayQuality, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static core:DisplayQuality.Fine}}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Menu_ModelPanel}" ToggleType="CheckBox" IsChecked="{Binding IsModelPanelVisible}" />
        <MenuItem Header="{loc:Tr Menu_ShortcutHints}" ToggleType="CheckBox" IsChecked="{Binding ShowShortcutHints}" />
        <Separator />
        <!-- Language names stay in their own language, so they can be found in any UI language. -->
        <MenuItem Header="{loc:Tr Menu_Language}">
          <MenuItem Header="English" ToggleType="Radio" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                    IsChecked="{Binding Culture.Name, Source={x:Static loc:Localizer.Instance}, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=en}" />
          <MenuItem Header="Deutsch" ToggleType="Radio" Command="{Binding SetLanguageCommand}" CommandParameter="de"
                    IsChecked="{Binding Culture.Name, Source={x:Static loc:Localizer.Instance}, Mode=OneWay, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=de}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{loc:Tr Menu_Tools}">
        <MenuItem Header="{loc:Tr Menu_ColourFace}" Command="{Binding ColorFaceCommand}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Paintbrush}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_ColourBody}" Command="{Binding ColorBodyCommand}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.PaintBucket}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_RemoveFaceColour}" Command="{Binding ClearFaceColorCommand}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Eraser}" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{loc:Tr Menu_CustomColour}" Command="{Binding #Root.OpenCustomColourCommand}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Pipette}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Menu_CheckAndRepair}" Command="{Binding #Root.RepairCommand}" IsEnabled="{Binding HasDocument}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Wrench}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{loc:Tr Menu_Help}">
        <MenuItem Header="{loc:Tr Menu_KeyboardShortcuts}" Command="{Binding #Root.ShowShortcutsCommand}" InputGesture="F1">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Keyboard}" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{loc:Tr Menu_About}" Command="{Binding #Root.ShowAboutCommand}">
          <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Info}" /></MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- 2 + 3 Toolbars. They never wrap: in narrow windows the inline palette and then the button
         texts disappear (icons and tooltips stay); every command is also in the menu. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1"
            Container.Name="bars" Container.Sizing="Width" ClipToBounds="True">
      <Border.Styles>
        <ContainerQuery Name="bars" Query="max-width:1180">
          <Style Selector="ListBox.inlinePalette">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </ContainerQuery>
        <ContainerQuery Name="bars" Query="max-width:900">
          <Style Selector="TextBlock.label">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </ContainerQuery>
      </Border.Styles>
      <StackPanel>
        <!-- 2 File and edit -->
        <StackPanel Orientation="Horizontal" Margin="6,4">
          <Button Classes="tool" Command="{Binding #Root.OpenCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{loc:Tr Tip_Open}">
            <StackPanel><controls:Icon Data="{StaticResource Icon.FolderOpen}" /><TextBlock Classes="label" Text="{loc:Tr Command_Open}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding #Root.SaveAsCommand}" IsEnabled="{Binding HasDocument}" ToolTip.Tip="{loc:Tr Tip_SaveAs}">
            <StackPanel><controls:Icon Data="{StaticResource Icon.Save}" /><TextBlock Classes="label" Text="{loc:Tr Command_SaveAs}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding #Root.RepairCommand}" IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="{loc:Tr Tip_Repair}">
            <StackPanel><controls:Icon Data="{StaticResource Icon.Wrench}" /><TextBlock Classes="label" Text="{loc:Tr Command_Repair}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding #Root.ExportDxfCommand}" IsEnabled="{Binding HasDocument}"
                  ToolTip.Tip="{loc:Tr Tip_ExportDxf}">
            <StackPanel><controls:Icon Data="{StaticResource Icon.FileOutput}" /><TextBlock Classes="label" Text="{loc:Tr Command_ExportDxf}" /></StackPanel>
          </Button>
          <Border Classes="toolSeparator" />
          <Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="{loc:Tr Tip_Undo}">
            <StackPanel><controls:Icon Data="{StaticResource Icon.Undo2}" /><TextBlock Classes="label" Text="{loc:Tr Command_Undo}" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="{loc:Tr Tip_Redo}">
            <StackPanel><controls:Icon Data="{StaticResource Icon.Redo2}" /><TextBlock Classes="label" Text="{loc:Tr Command_Redo}" /></StackPanel>
          </Button>
        </StackPanel>

        <!-- 3 View and colour -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0,6,4">
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <ToggleButton Classes="tool" IsChecked="{Binding IsModelPanelVisible}" ToolTip.Tip="{loc:Tr Tip_ModelPanel}">
              <controls:Icon Data="{StaticResource Icon.PanelLeft}" />
            </ToggleButton>
            <ToggleButton Classes="tool" IsChecked="{Binding ShowEdges}" ToolTip.Tip="{loc:Tr Tip_Edges}">
              <StackPanel><controls:Icon Data="{StaticResource Icon.Frame}" /><TextBlock Classes="label" Text="{loc:Tr Command_Edges}" /></StackPanel>
            </ToggleButton>
            <DropDownButton Classes="tool" ToolTip.Tip="{loc:Tr Tip_View}">
              <StackPanel><controls:Icon Data="{StaticResource Icon.Rotate3d}" /><TextBlock Classes="label" Text="{loc:Tr Command_View}" /></StackPanel>
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="{loc:Tr Command_Fit}" Command="{Binding #ModelViewControl.FitCommand}">
                    <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Scan}" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="{loc:Tr View_Front}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Front}" InputGesture="NumPad1" />
                  <MenuItem Header="{loc:Tr View_Back}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Back}" InputGesture="Ctrl+NumPad1" />
                  <MenuItem Header="{loc:Tr View_Left}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Left}" InputGesture="Ctrl+NumPad3" />
                  <MenuItem Header="{loc:Tr View_Right}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Right}" InputGesture="NumPad3" />
                  <MenuItem Header="{loc:Tr View_Top}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Top}" InputGesture="NumPad7" />
                  <MenuItem Header="{loc:Tr View_Bottom}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Bottom}" InputGesture="Ctrl+NumPad7" />
                  <MenuItem Header="{loc:Tr View_Isometric}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Iso}" InputGesture="NumPad0" />
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <ToggleButton Classes="tool" IsChecked="{Binding IsOrthographic}" ToolTip.Tip="{loc:Tr Tip_Orthographic}">
              <StackPanel><controls:Icon Data="{StaticResource Icon.Axis3d}" /><TextBlock Classes="label" Text="{loc:Tr Command_Orthographic}" /></StackPanel>
            </ToggleButton>
            <TextBlock Classes="label secondary" Text="{loc:Tr Command_Quality}" VerticalAlignment="Center" Margin="8,0,6,0" />
            <ComboBox ItemsSource="{Binding DisplayQualities}" SelectedItem="{Binding DisplayQuality}" IsEnabled="{Binding !IsBusy}"
                      VerticalAlignment="Center" MinWidth="96" Margin="0,0,2,0"
                      ToolTip.Tip="{loc:Tr Tip_Quality}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:DisplayQuality">
                  <TextBlock>
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static conv:LocalizedEnumConverter.Instance}">
                        <Binding />
                        <Binding Path="Culture" Source="{x:Static loc:Localizer.Instance}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Classes="toolSeparator" />
          </StackPanel>

          <!-- The palette takes the remaining width; it is hidden in narrow windows (the colour button stays). -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" ClipToBounds="True">
            <DropDownButton x:Name="ColourButton" Classes="tool" Padding="6,4" ToolTip.Tip="{loc:Tr Tip_ColourButton}">
              <Border Classes="swatch" Background="{Binding SelectedPaletteEntry.Hex}" />
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <!-- Scrolls instead of growing beyond the screen when the RAL list or the picker is open. -->
                  <ScrollViewer MaxHeight="660" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Width="300" Spacing="{StaticResource SpaceS}" Margin="0,0,10,0">
                    <TextBlock Classes="header" Text="{loc:Tr Colour_Active}" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Command="{Binding AddFavouriteCommand}" VerticalAlignment="Center" Padding="8,4"
                              ToolTip.Tip="{loc:Tr Tip_AddFavourite}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Data="{StaticResource Icon.Star}" /><TextBlock Text="{loc:Tr Colour_AddFavourite}" /></StackPanel>
                      </Button>
                      <Border DockPanel.Dock="Left" Classes="swatch" Width="32" Height="32" Margin="0,0,10,0" Background="{Binding SelectedPaletteEntry.Hex}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedPaletteEntry.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary" Text="{Binding SelectedPaletteEntry.Hex}" />
                      </StackPanel>
                    </DockPanel>
                    <!-- Name of a new or renamed favourite -->
                    <DockPanel IsVisible="{Binding IsEditingFavourite}">
                      <Button DockPanel.Dock="Right" Classes="tool" Padding="6" Command="{Binding CancelFavouriteCommand}" ToolTip.Tip="{loc:Tr Tip_CancelFavourite}">
                        <controls:Icon Data="{StaticResource Icon.X}" />
                      </Button>
                      <Button DockPanel.Dock="Right" Classes="tool" Padding="6" Command="{Binding SaveFavouriteCommand}" ToolTip.Tip="{loc:Tr Tip_SaveFavourite}">
                        <controls:Icon Data="{StaticResource Icon.Check}" />
                      </Button>
                      <TextBox x:Name="FavouriteNameBox" Text="{Binding FavouriteDraftName}" Watermark="{loc:Tr Colour_FavouriteName}" MaxLength="60">
                        <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding SaveFavouriteCommand}" />
                          <KeyBinding Gesture="Escape" Command="{Binding CancelFavouriteCommand}" />
                        </TextBox.KeyBindings>
                      </TextBox>
                    </DockPanel>

                    <TextBlock Classes="header" Text="{loc:Tr Colour_Palette}" Margin="0,4,0,0" />
                    <ListBox Classes="palette" ItemsSource="{Binding Palette}" SelectedItem="{Binding PaletteSelection}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteEntry">
                          <Panel ToolTip.Tip="{Binding Description}">
                            <Border Classes="swatch" Width="26" Height="26" Background="{Binding Hex}" />
                            <Border Classes="selectedBadge"><controls:Icon Data="{StaticResource Icon.Check}" /></Border>
                          </Panel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Classes="header" Text="{loc:Tr Colour_Favourites}" Margin="0,4,0,0" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="12" Text="{loc:Tr Colour_NoFavourites}" IsVisible="{Binding !HasFavourites}" />
                    <!-- Right-click selects a favourite and offers rename, remove and reorder. -->
                    <ListBox x:Name="FavouritesList" Classes="colourList" ItemsSource="{Binding Favourites}" SelectedItem="{Binding FavouriteSelection}"
                             MaxHeight="170" IsVisible="{Binding HasFavourites}">
                      <ListBox.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{loc:Tr Menu_Rename}" Command="{Binding RenameFavouriteCommand}" CommandParameter="{Binding FavouriteSelection}">
                            <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Pencil}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{loc:Tr Menu_MoveUp}" Command="{Binding MoveFavouriteUpCommand}" CommandParameter="{Binding FavouriteSelection}">
                            <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.ArrowUp}" /></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="{loc:Tr Menu_MoveDown}" Command="{Binding MoveFavouriteDownCommand}" CommandParameter="{Binding FavouriteSelection}">
                            <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.ArrowDown}" /></MenuItem.Icon>
                          </MenuItem>
                          <Separator />
                          <MenuItem Header="{loc:Tr Menu_Remove}" Command="{Binding RemoveFavouriteCommand}" CommandParameter="{Binding FavouriteSelection}">
                            <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Trash2}" /></MenuItem.Icon>
                          </MenuItem>
                        </ContextMenu>
                      </ListBox.ContextMenu>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteEntry">
                          <DockPanel ToolTip.Tip="{Binding Description}">
                            <Border DockPanel.Dock="Left" Classes="swatch" Width="18" Height="18" Margin="0,0,8,0" Background="{Binding Hex}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Classes="header" Text="{loc:Tr Colour_ApplyTo}" Margin="0,4,0,0" />
                    <Button Command="{Binding ColorFaceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            ToolTip.Tip="{loc:Tr Tip_ColourFacePanel}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><controls:Icon Data="{StaticResource Icon.Paintbrush}" /><TextBlock Text="{loc:Tr Command_ColourFace}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ColorBodyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            ToolTip.Tip="{loc:Tr Tip_ColourBody}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><controls:Icon Data="{StaticResource Icon.PaintBucket}" /><TextBlock Text="{loc:Tr Command_ColourBody}" /></StackPanel>
                    </Button>
                    <Button Command="{Binding ClearFaceColorCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            ToolTip.Tip="{loc:Tr Tip_RemoveFaceColourPanel}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><controls:Icon Data="{StaticResource Icon.Eraser}" /><TextBlock Text="{loc:Tr Command_RemoveFaceColour}" /></StackPanel>
                    </Button>
                    <Expander HorizontalAlignment="Stretch" Margin="0,4,0,0" ToolTip.Tip="{loc:Tr Tip_RalList}">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:Icon Data="{StaticResource Icon.Palette}" /><TextBlock Text="{loc:Tr Colour_RalColours}" /></StackPanel>
                      </Expander.Header>
                      <StackPanel Spacing="6">
                        <TextBox Text="{Binding RalSearch}" Watermark="{loc:Tr Colour_RalSearch}">
                          <TextBox.InnerLeftContent>
                            <controls:Icon Data="{StaticResource Icon.Search}" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                          </TextBox.InnerLeftContent>
                        </TextBox>
                        <ListBox x:Name="RalList" Classes="colourList" ItemsSource="{Binding RalColours}" SelectedItem="{Binding RalSelection}" Height="220">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PaletteEntry">
                              <DockPanel ToolTip.Tip="{Binding Hex}">
                                <Border DockPanel.Dock="Left" Classes="swatch" Width="18" Height="18" Margin="0,0,8,0" Background="{Binding Hex}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Expander>
                    <!-- Compact picker from the colour picker's primitives: the full ColorView does not fit
                         the panel. Last in the panel, so expanding it does not push the actions away. -->
                    <Expander x:Name="CustomColourExpander" HorizontalAlignment="Stretch" Margin="0,4,0,0" Expanding="OnCustomColourExpanding">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8"><controls:Icon Data="{StaticResource Icon.Pipette}" /><TextBlock Text="{loc:Tr Colour_Custom}" /></StackPanel>
                      </Expander.Header>
                      <StackPanel Spacing="8">
                        <primitives:ColorSpectrum x:Name="CustomSpectrum" Height="140" Components="HueSaturation" Shape="Box"
                                                  CornerRadius="4" Color="#3366CC" ColorChanged="OnCustomSpectrumColorChanged" />
                        <primitives:ColorSlider ColorModel="Hsva" ColorComponent="Component3" Orientation="Horizontal"
                                                HsvColor="{Binding #CustomSpectrum.HsvColor, Mode=TwoWay}" IsAlphaVisible="False"
                                                ToolTip.Tip="{loc:Tr Tip_Brightness}" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" x:Name="UseCustomColourButton" Content="{loc:Tr Colour_Use}" Click="OnUseCustomColorClick" Margin="8,0,0,0"
                                  ToolTip.Tip="{loc:Tr Tip_UseColour}" />
                          <Border DockPanel.Dock="Left" Classes="swatch" Width="30" Height="30" Margin="0,0,8,0"
                                  Background="{Binding #CustomSpectrum.Color, Converter={x:Static conv:ColorToBrushConverter.Instance}}" />
                          <TextBox x:Name="CustomHexBox" Watermark="#RRGGBB" VerticalAlignment="Center" MaxLength="7"
                                   KeyDown="OnCustomHexKeyDown" LostFocus="OnCustomHexLostFocus" ToolTip.Tip="{loc:Tr Tip_HexInput}" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                  </ScrollViewer>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <ListBox Classes="palette inlinePalette" ItemsSource="{Binding Palette}" SelectedItem="{Binding PaletteSelection}" Margin="4,0,0,0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteEntry">
                  <Panel ToolTip.Tip="{Binding Description}">
                    <Border Classes="swatch" Background="{Binding Hex}" />
                    <Border Classes="selectedBadge"><controls:Icon Data="{StaticResource Icon.Check}" /></Border>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Border Classes="toolSeparator" />
            <Button Classes="tool" Command="{Binding ColorFaceCommand}" ToolTip.Tip="{loc:Tr Tip_ColourFace}">
              <StackPanel><controls:Icon Data="{StaticResource Icon.Paintbrush}" /><TextBlock Classes="label" Text="{loc:Tr Command_ColourFace}" /></StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding ColorBodyCommand}"
                    ToolTip.Tip="{loc:Tr Tip_ColourBody}">
              <StackPanel><controls:Icon Data="{StaticResource Icon.PaintBucket}" /><TextBlock Classes="label" Text="{loc:Tr Command_ColourBody}" /></StackPanel>
            </Button>
            <Button Classes="tool" Command="{Binding ClearFaceColorCommand}" ToolTip.Tip="{loc:Tr Tip_RemoveFaceColour}">
              <StackPanel><controls:Icon Data="{StaticResource Icon.Eraser}" /><TextBlock Classes="label" Text="{loc:Tr Command_RemoveFaceColour}" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- 8 Shortcut hints (optional) -->
    <Border DockPanel.Dock="Bottom" Padding="10,3,4,3" Background="{StaticResource WindowBrush}" IsVisible="{Binding ShowShortcutHints}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="tool" Padding="4" Command="{Binding ToggleShortcutHintsCommand}" ToolTip.Tip="{loc:Tr Tip_HideHints}">
          <controls:Icon Data="{StaticResource Icon.X}" Width="12" Height="12" />
        </Button>
        <TextBlock Classes="secondary" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Text="{loc:Tr Hints_Line}" />
      </DockPanel>
    </Border>

    <!-- 7 Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Container.Name="status" Container.Sizing="Width">
      <Border.Styles>
        <ContainerQuery Name="status" Query="max-width:900">
          <Style Selector=":is(Control).wideOnly">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </ContainerQuery>
      </Border.Styles>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" IsVisible="{Binding IsCancellable}">
          <TextBlock FontSize="{StaticResource FontSizeStatus}" Text="{Binding ProgressText}" VerticalAlignment="Center" />
          <ProgressBar Width="140" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" VerticalAlignment="Center" />
          <Button Content="{loc:Tr Common_Cancel}" Command="{Binding CancelCommand}" Padding="8,0" FontSize="{StaticResource FontSizeStatus}" ToolTip.Tip="{loc:Tr Tip_Esc}" />
        </StackPanel>
        <!-- Operations without progress reports (saving, export, colouring, repair) -->
        <ProgressBar DockPanel.Dock="Right" Width="80" IsIndeterminate="True" VerticalAlignment="Center" Margin="12,0,0,0">
          <ProgressBar.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsBusy" />
              <Binding Path="!IsCancellable" />
            </MultiBinding>
          </ProgressBar.IsVisible>
        </ProgressBar>
        <TextBlock DockPanel.Dock="Right" Classes="wideOnly" FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center" Margin="12,0,0,0">
          <Run Text="{loc:Tr Status_ActiveColour}" /><Run Text=" " /><Run Text="{Binding SelectedPaletteEntry.Name}" />
        </TextBlock>
        <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                   Text="{Binding SelectionInfo}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        <TextBlock DockPanel.Dock="Right" Classes="secondary wideOnly" FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                   Text="{Binding HoverInfo}" />
        <!-- Own IsVisible binding inside: a local value would override the narrow-window style. -->
        <Panel DockPanel.Dock="Right" Classes="wideOnly">
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" IsVisible="{Binding HasDocument}">
            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{loc:Tr Tip_PartCount}">
              <controls:Icon Data="{StaticResource Icon.Box}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center"><Run Text="{Binding PartCount, StringFormat=N0}" /><Run Text=" " /><Run Text="{loc:Tr Status_Parts}" /></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:Icon Data="{StaticResource Icon.Square}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center"><Run Text="{Binding FaceCount, StringFormat=N0}" /><Run Text=" " /><Run Text="{loc:Tr Status_Faces}" /></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{loc:Tr Tip_TriangleCount}">
              <controls:Icon Data="{StaticResource Icon.Triangle}" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center"><Run Text="{Binding TriangleCount, StringFormat=N0}" /><Run Text=" " /><Run Text="{loc:Tr Status_Triangles}" /></TextBlock>
            </StackPanel>
          </StackPanel>
        </Panel>
        <TextBlock FontSize="{StaticResource FontSizeStatus}" VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 4 Model panel, 5 viewport -->
    <Grid x:Name="ContentGrid" ColumnDefinitions="260,4,*">
      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" IsVisible="{Binding IsModelPanelVisible}" MinWidth="160">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="10,6,4,4">
            <Button DockPanel.Dock="Right" Classes="tool" Padding="4" Command="{Binding ToggleModelPanelCommand}" ToolTip.Tip="{loc:Tr Tip_HideModelPanel}">
              <controls:Icon Data="{StaticResource Icon.PanelLeft}" Width="14" Height="14" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:Icon Data="{StaticResource Icon.ListTree}" />
              <TextBlock Classes="header" Text="{loc:Tr Panel_Model}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="10,4" TextWrapping="Wrap" FontSize="12"
                     Text="{loc:Tr Panel_ModelEmpty}" IsVisible="{Binding !HasDocument}" />
          <TreeView ItemsSource="{Binding ModelTree}" SelectedItem="{Binding SelectedNode}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="core:ModelNode" ItemsSource="{Binding Children}">
                <DockPanel ToolTip.Tip="{Binding DisplayName}">
                  <Panel DockPanel.Dock="Left" Margin="0,0,6,0">
                    <controls:Icon Data="{StaticResource Icon.Boxes}"
                                   IsVisible="{Binding Kind, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static core:ModelNodeKind.Assembly}}" />
                    <controls:Icon Data="{StaticResource Icon.Box}"
                                   IsVisible="{Binding Kind, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static core:ModelNodeKind.Part}}" />
                    <controls:Icon Data="{StaticResource Icon.Square}" Width="14" Height="14"
                                   IsVisible="{Binding Kind, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter={x:Static core:ModelNodeKind.Body}}" />
                  </Panel>
                  <TextBlock DockPanel.Dock="Left" Classes="secondary" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock.Text>
                      <MultiBinding Converter="{x:Static conv:LocalizedEnumConverter.Instance}">
                        <Binding Path="Kind" />
                        <Binding Path="Culture" Source="{x:Static loc:Localizer.Instance}" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Background="{StaticResource BorderBrush}" ResizeDirection="Columns" IsVisible="{Binding IsModelPanelVisible}" />
      <controls:ModelView Grid.Column="2" x:Name="ModelViewControl"
                          Scene="{Binding Scene}" SelectedFace="{Binding SelectedFace}"
                          HighlightedFaces="{Binding HighlightedFaces}" HoveredFace="{Binding HoveredFace}" ShowEdges="{Binding ShowEdges}"
                          IsOrthographic="{Binding IsOrthographic}">
        <controls:ModelView.FaceMenu>
          <MenuFlyout>
            <MenuItem Header="{loc:Tr Command_ColourFace}" Command="{Binding ColorFaceCommand}">
              <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Paintbrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Command_ColourBody}" Command="{Binding ColorBodyCommand}">
              <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.PaintBucket}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr Command_RemoveFaceColour}" Command="{Binding ClearFaceColorCommand}">
              <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Eraser}" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{loc:Tr Command_Fit}" Command="{Binding #ModelViewControl.FitCommand}">
              <MenuItem.Icon><controls:Icon Data="{StaticResource Icon.Scan}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{loc:Tr View_Front}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Front}" InputGesture="NumPad1" />
            <MenuItem Header="{loc:Tr View_Right}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Right}" InputGesture="NumPad3" />
            <MenuItem Header="{loc:Tr View_Top}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Top}" InputGesture="NumPad7" />
            <MenuItem Header="{loc:Tr View_Isometric}" Command="{Binding #ModelViewControl.ShowViewCommand}" CommandParameter="{x:Static drawing:ViewDirection.Iso}" InputGesture="NumPad0" />
          </MenuFlyout>
        </controls:ModelView.FaceMenu>
      </controls:ModelView>
    </Grid>
  </DockPanel>
</Window>
