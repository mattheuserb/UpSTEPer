<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:UpSTEPer.App.Localization"
        xmlns:vm="using:UpSTEPer.App.ViewModels"
        xmlns:controls="using:UpSTEPer.App.Controls"
        x:Class="UpSTEPer.App.Views.RepairWindow"
        x:ClassModifier="internal"
        x:DataType="vm:RepairViewModel"
        Title="{loc:Tr Repair_Title}"
        Width="1000" Height="660" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Main.CancelCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- Summary tiles -->
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style Selector="Border.tile TextBlock.count">
      <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tile TextBlock.caption">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="FontSize" Value="{StaticResource FontSizeTable}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="CanUserReorderColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16,12,16,12" Container.Name="dialog" Container.Sizing="Width">
    <DockPanel.Styles>
      <!-- Narrow: the explanation moves into the title's tooltip. -->
      <ContainerQuery Name="dialog" Query="max-width:700">
        <Style Selector="TextBlock.explanation">
          <Setter Property="IsVisible" Value="False" />
        </Style>
      </ContainerQuery>
    </DockPanel.Styles>
    <!-- 1 Title and explanation -->
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8" ToolTip.Tip="{Binding #Explanation.Text}">
        <controls:Icon Data="{StaticResource Icon.Wrench}" Width="18" Height="18" />
        <TextBlock Text="{loc:Tr Repair_Title}" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="Explanation" Classes="secondary explanation" TextWrapping="Wrap"
                 Text="{loc:Tr Repair_Explanation}" />
    </StackPanel>

    <!-- 2 Summary, computed from the results -->
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Classes="secondary" Margin="0,0,0,8" IsVisible="{Binding !HasCheckResults}"
                 Text="{loc:Tr Repair_NoResults}" />
      <WrapPanel IsVisible="{Binding ShowsCheckSummary}">
        <Border Classes="tile" ToolTip.Tip="{loc:Tr Repair_TipPartsChecked}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Data="{StaticResource Icon.Box}" />
            <TextBlock Classes="count" Text="{Binding PartsChecked}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_PartsChecked}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Ok" />
            <TextBlock Classes="count" Text="{Binding PartsOk}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_WithoutProblems}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Warning" />
            <TextBlock Classes="count" Text="{Binding PartsWithProblems}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_WithProblems}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" IsVisible="{Binding PartsWithCheckErrors}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Error" />
            <TextBlock Classes="count" Text="{Binding PartsWithCheckErrors}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_WithFailedChecks}" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <WrapPanel IsVisible="{Binding ShowsRepairSummary}">
        <Border Classes="tile">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Ok" />
            <TextBlock Classes="count" Text="{Binding PartsRepaired}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_Repaired}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Unchanged" />
            <TextBlock Classes="count" Text="{Binding PartsUnchanged}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_Unchanged}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" ToolTip.Tip="{loc:Tr Repair_TipNeedAttention}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Warning" />
            <TextBlock Classes="count" Text="{Binding PartsNeedingAttention}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_NeedAttention}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" IsVisible="{Binding PartsFailed}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:StatusBadge Status="Error" />
            <TextBlock Classes="count" Text="{Binding PartsFailed}" />
            <TextBlock Classes="caption" Text="{loc:Tr Repair_Failed}" />
          </StackPanel>
        </Border>
      </WrapPanel>
    </StackPanel>

    <!-- 6 + 7 Actions, progress and result line: always visible at the bottom -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding CheckCommand}" IsEnabled="{Binding !Main.IsBusy}" ToolTip.Tip="{loc:Tr Repair_TipCheck}">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Data="{StaticResource Icon.ScanSearch}" /><TextBlock Text="{loc:Tr Repair_Check}" /></StackPanel>
        </Button>
        <Button Classes="accent" Command="{Binding RepairCommand}" IsEnabled="{Binding !Main.IsBusy}" ToolTip.Tip="{loc:Tr Repair_TipRepair}">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Data="{StaticResource Icon.Wrench}" /><TextBlock Text="{loc:Tr Repair_Repair}" /></StackPanel>
        </Button>
        <Button Command="{Binding Main.UndoRepairCommand}" IsEnabled="{Binding !Main.IsBusy}" ToolTip.Tip="{loc:Tr Repair_TipUndo}">
          <StackPanel Orientation="Horizontal" Spacing="6"><controls:Icon Data="{StaticResource Icon.Undo2}" /><TextBlock Text="{loc:Tr Repair_Undo}" /></StackPanel>
        </Button>
        <Button Content="{loc:Tr Common_Close}" Click="OnCloseClick" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" IsVisible="{Binding Main.IsCancellable}">
        <TextBlock FontSize="{StaticResource FontSizeStatus}" Text="{Binding Main.ProgressText}" VerticalAlignment="Center" />
        <ProgressBar Width="120" Minimum="0" Maximum="1" Value="{Binding Main.ProgressFraction}" VerticalAlignment="Center" />
        <Button Content="{loc:Tr Common_Cancel}" Command="{Binding Main.CancelCommand}" Padding="8,2" FontSize="{StaticResource FontSizeStatus}" ToolTip.Tip="{loc:Tr Tip_Esc}" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="{StaticResource FontSizeStatus}" />
    </DockPanel>

    <!-- 5 Repair options -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SubtleBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
      <WrapPanel>
        <TextBlock Classes="header" Text="{loc:Tr Repair_Steps}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <CheckBox Content="{loc:Tr Repair_Fix}" IsChecked="{Binding Fix}" Margin="0,0,12,0"
                  ToolTip.Tip="{loc:Tr Repair_TipFix}" />
        <CheckBox Content="{loc:Tr Repair_Sew}" IsChecked="{Binding Sew}" Margin="0,0,12,0"
                  ToolTip.Tip="{loc:Tr Repair_TipSew}" />
        <CheckBox Content="{loc:Tr Repair_Canonical}" IsChecked="{Binding Canonical}" Margin="0,0,12,0"
                  ToolTip.Tip="{loc:Tr Repair_TipCanonical}" />
        <CheckBox Content="{loc:Tr Repair_Merge}" IsChecked="{Binding MergeFaces}" Margin="0,0,20,0"
                  ToolTip.Tip="{loc:Tr Repair_TipMerge}" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{loc:Tr Repair_Tolerance}" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding Tolerance}" Minimum="0.001" Maximum="1" Increment="0.01" FormatString="0.###" Width="130"
                         ToolTip.Tip="{loc:Tr Repair_TipTolerance}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- 3 + 4 Tables with details of the selected part -->
    <TabControl SelectedIndex="{Binding SelectedReportIndex}" Padding="0,6,0,0">
      <TabItem Header="{loc:Tr Repair_CheckResults}">
        <Grid RowDefinitions="*,Auto" Container.Name="report" Container.Sizing="Height">
          <Grid.Styles>
            <!-- Low: the table keeps the space; status and summary are in its rows. -->
            <ContainerQuery Name="report" Query="max-height:260">
              <Style Selector="Panel.details">
                <Setter Property="IsVisible" Value="False" />
              </Style>
            </ContainerQuery>
          </Grid.Styles>
          <DataGrid x:Name="CheckGrid" MinHeight="90" ItemsSource="{Binding CheckRows}" SelectedItem="{Binding SelectedCheckRow}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{loc:Tr Repair_ColumnStatus}" Width="Auto" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:CheckRow">
                    <controls:StatusBadge Status="{Binding Status}" Text="{Binding StatusText}" Margin="8,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn x:DataType="vm:CheckRow" Header="{loc:Tr Repair_ColumnPart}" Binding="{Binding Part.DisplayName}" Width="2*" MinWidth="140" />
              <DataGridTextColumn x:DataType="vm:CheckRow" Header="{loc:Tr Repair_ColumnFindings}" Binding="{Binding Findings}" Width="3*" MinWidth="180" />
            </DataGrid.Columns>
          </DataGrid>
          <!-- Own IsVisible binding inside: a local value would override the height query. -->
          <Panel Grid.Row="1" Classes="details">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0"
                    IsVisible="{Binding SelectedCheckRow, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="4">
                <TextBlock Classes="header"><Run Text="{loc:Tr Common_DetailsFor}" /><Run Text=" " /><Run Text="{Binding SelectedCheckRow.Part.DisplayName}" /></TextBlock>
                <ItemsControl ItemsSource="{Binding SelectedCheckRow.Details}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailItem">
                      <StackPanel Orientation="Horizontal" Spacing="6" Width="250" Margin="0,2">
                        <TextBlock Classes="secondary" Text="{Binding Label}" FontSize="{StaticResource FontSizeTable}" />
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTable}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Panel>
        </Grid>
      </TabItem>
      <TabItem Header="{loc:Tr Repair_Report}" IsEnabled="{Binding HasRepairReport}">
        <Grid RowDefinitions="*,Auto" Container.Name="report" Container.Sizing="Height">
          <Grid.Styles>
            <!-- Low: the table keeps the space; status and summary are in its rows. -->
            <ContainerQuery Name="report" Query="max-height:260">
              <Style Selector="Panel.details">
                <Setter Property="IsVisible" Value="False" />
              </Style>
            </ContainerQuery>
          </Grid.Styles>
          <DataGrid x:Name="RepairGrid" MinHeight="90" ItemsSource="{Binding RepairRows}" SelectedItem="{Binding SelectedRepairRow}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{loc:Tr Repair_ColumnStatus}" Width="Auto" MinWidth="135">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:RepairRow">
                    <controls:StatusBadge Status="{Binding Status}" Text="{Binding StatusText}" Margin="8,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn x:DataType="vm:RepairRow" Header="{loc:Tr Repair_ColumnPart}" Binding="{Binding Part.DisplayName}" Width="2*" MinWidth="140" />
              <DataGridTextColumn x:DataType="vm:RepairRow" Header="{loc:Tr Repair_ColumnChanges}" Binding="{Binding Changes}" Width="3*" MinWidth="180" />
            </DataGrid.Columns>
          </DataGrid>
          <!-- Own IsVisible binding inside: a local value would override the height query. -->
          <Panel Grid.Row="1" Classes="details">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,6,0,0"
                    IsVisible="{Binding SelectedRepairRow, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="4">
                <TextBlock Classes="header"><Run Text="{loc:Tr Common_DetailsFor}" /><Run Text=" " /><Run Text="{Binding SelectedRepairRow.Part.DisplayName}" /></TextBlock>
                <ItemsControl ItemsSource="{Binding SelectedRepairRow.Details}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailItem">
                      <StackPanel Orientation="Horizontal" Spacing="6" Width="250" Margin="0,2">
                        <TextBlock Classes="secondary" Text="{Binding Label}" FontSize="{StaticResource FontSizeTable}" />
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTable}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Panel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
